# Copie este arquivo para ".env" (nunca commitado) e preencha com suas credenciais reais.
# Painel do Mercado Pago: https://www.mercadopago.com.br/developers/panel/app

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_PUBLIC_KEY=

# URL pública do site. Local: http://projetoz.local — produção: https://arkz.dev.br
APP_FRONTEND_URL=
APP_BACKEND_URL=

# Chave compartilhada com o mod do servidor de jogo (consulta VIP/coins/inventário por SteamID)
GAMESERVER_API_KEY=

# Google Cloud Console: OAuth 2.0 Client (vínculo de canal do YouTube pro
# ranking de clipes) + chave de API restrita à YouTube Data API v3.
# Redirect URIs autorizadas: https://arkz.dev.br/signin-google e http://localhost/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_YOUTUBE_API_KEY=
